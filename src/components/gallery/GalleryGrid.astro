---
import { Picture } from 'astro:assets'
import type { Gallery } from '@/types'

interface Props {
    gallery: Gallery[]
}
const { gallery } = Astro.props
---
<div id="gallery" class="grid grid-cols-1 lg:grid-cols-3 gap-5">
    {
        gallery.map(image => (
           <a
                href={image.full.url}
                data-pswp-width={image.full.width}
                data-pswp-height={image.full.height}
                target="_blank"
           >
                <Picture 
                    src={image.large.url}
                    alt={'Galería de imágenes'}
                    width={image.large.width}
                    height={image.large.height}
                    formats={['avif', 'webp']}
                />
           </a>
        ))
    }
</div>

<!-- 
    Todos los scrips que coloque de esta forma
    tiene una caracteristicas importante.

    Se procesará en el bundle final. 
    Con astro esto es facil ya que no necesita vite, webpack u otro bundler.
-->
<script>
    import PhotoSwipeLightbox from 'photoswipe/lightbox'
    import 'photoswipe/style.css'

    const lightbox = new PhotoSwipeLightbox({
        gallery: '#gallery',
        children: 'a',
        pswpModule: () => import('photoswipe')
    })

    lightbox.init()

     document.addEventListener('astro:after-swap', function() {
        lightbox.init()
    })

</script>