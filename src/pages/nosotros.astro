---
import Layout from "@/layouts/Layout.astro";
import { BaseWPSchema } from "@/types/"
import { Picture } from "astro:assets";

// Top level await.
const URL = `${import.meta.env.API_URL}/pages?slug=nosotros`;
const res = await fetch(URL)
const json = await res.json()
const data = BaseWPSchema.parse(json[0])

---

<Layout 
    title={data.title.rendered} 
    subtitle={data.acf.subtitle}
    bgImage={data.featured_images.full.url}
>
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 ">
        <!-- 
            Dado que la imagen inicialmente se consume de manera remota.
            Los formatos no serán tomados en cuenta para mostrar las imagenes.
            Es necesario agregar reglas adicionales astro.config.mjs.
        -->
        <Picture 
            src={data.featured_images.medium_large.url} 
            alt={`Imagen de ${data.title.rendered}`} 
            formats={["avif", "webp"]}
            width={data.featured_images.medium_large.width}
            height={data.featured_images.medium_large.height}
        />
        <div class="text-xl space-y-3 mt-10 lg:mt-0" set:html={data.content.rendered}></div>
    </div>
</Layout>